# Copy this file to ".env" and fill in real values. Never commit ".env".

# ---- Server ----
PORT=4000
# Public URL where this server (and the /public site) is reachable.
# Magic-link emails and Razorpay redirects use this.
BASE_URL=http://localhost:4000
NODE_ENV=development

# ---- Auth (magic link) ----
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string
MAGIC_LINK_EXPIRY_MINUTES=15
SESSION_EXPIRY_DAYS=180

# ---- Outgoing email (SMTP) — used to send the magic login link ----
# Any SMTP provider works: Gmail (with an App Password), SendGrid, Postmark, Amazon SES, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="AgroVista Monthly <no-reply@agrovistamonthly.com>"

# ---- Razorpay ----
# From https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# From Dashboard > Settings > Webhooks (create a webhook pointing to BASE_URL/api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- Currency ----
CURRENCY=INR
