# Copy this file to ".env.local" and fill in real values. Never commit ".env.local".

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Adapter selection — 'stub' until real services are wired (see /lib/adapters) ----
# 'stub' adapters no-op (log to console) so the app runs with zero external services.
STORAGE_ADAPTER=stub
PAYMENT_ADAPTER=stub
NOTIFIER_ADAPTER=stub
SENTRY_ENABLED=false
SENTRY_DSN=

# ---- Supabase (Postgres + Storage) — required once STORAGE_ADAPTER=supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

SUPABASE_POSTERS_BUCKET=issue-posters
SUPABASE_ISSUE_PDFS_BUCKET=issue-pdfs
SUPABASE_SUBMISSION_FILES_BUCKET=submission-files
SUPABASE_ADMIN_EDITS_BUCKET=admin-edits

# ---- Auth (bcrypt + JWT, role-based) ----
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRY_DAYS=7
SESSION_COOKIE_NAME=agrovista_session

# ---- Razorpay — required once PAYMENT_ADAPTER=razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
CURRENCY=INR

# ---- Notifications — used when NOTIFIER_ADAPTER=email-sms ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="AgroVista <your-gmail-address@gmail.com>"

# Email is the default notification channel; SMS stays off until explicitly enabled.
FAST2SMS_API_KEY=your-fast2sms-api-key
SMS_NOTIFICATIONS_ENABLED=false
